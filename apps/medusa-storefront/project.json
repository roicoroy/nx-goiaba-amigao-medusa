{
  "name": "medusa-server-storefront",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/medusa-storefront/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next build",
        "cwd": "apps/medusa-storefront"
      },
      "outputs": [
        "{projectRoot}/.next",
        "{projectRoot}/.next/cache"
      ],
      "cache": true
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next dev --turbopack -p 8000",
        "cwd": "apps/medusa-storefront"
      },
      "cache": false
    },
    "start": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "next start -p 8000",
        "cwd": "apps/medusa-storefront"
      },
      "cache": false
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next lint",
        "cwd": "apps/medusa-storefront"
      },
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/.eslintrc.json",
        "{projectRoot}/.eslintrc.js"
      ]
    },
    "analyze": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ANALYZE=true next build",
        "cwd": "apps/medusa-storefront"
      },
      "cache": false
    }
  },
  "tags": []
}
