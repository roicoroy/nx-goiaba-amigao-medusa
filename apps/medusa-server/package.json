{
  "name": "medusa-serve",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "start": "medusa start",
    "dev": "CHOKIDAR_USEPOLLING=true CHOKIDAR_IGNORED='plugins/**' medusa develop",
    "migrate": "medusa db:migrate",
    "migrate:user": "medusa exec ./src/scripts/run-user-migration.ts",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:http:running": "TEST_AGAINST_RUNNING_SERVER=true TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:http:health": "TEST_AGAINST_RUNNING_SERVER=true TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit health",
    "test:integration:http:customer-login": "TEST_AGAINST_RUNNING_SERVER=true TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit customer-login",
    "test:integration:http:customer-registration": "TEST_AGAINST_RUNNING_SERVER=true TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit customer-registration",
    "test:integration:http:products-bought-together": "TEST_AGAINST_RUNNING_SERVER=true TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit products-bought-together",
    "test:integration:http:product-reviews": "TEST_AGAINST_RUNNING_SERVER=true TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit product-reviews",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "test": "yarn test:unit && yarn test:integration:http:running",
    "ngrok": "./start-ngrok.sh",
    "dev:tunnel": "concurrently \"yarn dev\" \"yarn ngrok\"",
    "widget:create": "node scripts/create-widget.js",
    "wishlist:build": "cd plugins/wishlist-plugin && npm run build",
    "wishlist:deploy": "cd plugins/wishlist-plugin && npm run deploy",
    "wishlist:update": "yalc update wishlist-plugin",
    "wishlist:sync": "cd plugins/wishlist-plugin && npm run deploy && cd ../.. && yalc update wishlist-plugin",
    "plugins:build": "cd plugins/wishlist-plugin && npm run build && cd ../medusa-documents && npm run build && cd ../medusa-products-bought-together && npm run build && cd ../webhooks && npm run build && cd ../product-reviews && npm run build && cd ../..",
    "plugins:deploy": "cd plugins/wishlist-plugin && npm run deploy && cd ../medusa-documents && npm run deploy && cd ../medusa-products-bought-together && npm run deploy && cd ../webhooks && npm run deploy && cd ../product-reviews && npm run deploy && cd ../..",
    "plugins:add": "yalc add wishlist-plugin medusa-documents @rsc-labs/medusa-products-bought-together-v2 @lambdacurry/medusa-webhooks @blegaut/medusa-product-reviews-enhanced",
    "plugins:update": "yalc update wishlist-plugin && yalc update medusa-documents && yalc update @rsc-labs/medusa-products-bought-together-v2 && yalc update @lambdacurry/medusa-webhooks && yalc update @blegaut/medusa-product-reviews-enhanced",
    "plugins:sync": "yarn plugins:deploy && yalc add wishlist-plugin medusa-documents @rsc-labs/medusa-products-bought-together-v2 @lambdacurry/medusa-webhooks @blegaut/medusa-product-reviews-enhanced"
  },
  "dependencies": {
    "@blegaut/medusa-product-reviews-enhanced": "workspace:*",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@lambdacurry/medusa-webhooks": "workspace:*",
    "@medusajs/admin-sdk": "2.12.3",
    "@medusajs/cli": "2.12.3",
    "@medusajs/framework": "2.12.3",
    "@medusajs/fulfillment-manual": "2.12.3",
    "@medusajs/medusa": "2.12.3",
    "@mui/material": "^6.1.2",
    "@perseidesjs/notification-nodemailer": "^2.0.0",
    "@rsc-labs/medusa-products-bought-together-v2": "workspace:*",
    "@tanstack/react-query": "^5.90.9",
    "@types/nodemailer": "^7.0.3",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.8.0",
    "firebase-admin": "^13.6.0",
    "medusa-documents": "workspace:*",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.10",
    "pdfkit": "^0.15.1",
    "react-hook-form": "^7.53.0",
    "react-json-view-lite": "^2.3.0",
    "react-player": "^3.3.3",
    "recharts": "^2.13.3",
    "socket.io": "^4.8.1",
    "wishlist-plugin": "workspace:*",
    "pg": "^8.16.3",
    "@mikro-orm/core": "6.4.16",
    "@mikro-orm/migrations": "6.4.16"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.12.3",
    "@swc/core": "1.5.7",
    "@swc/jest": "^0.2.36",
    "@types/bcrypt": "^6.0.0",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.7",
    "@types/d3-time": "^3.0.4",
    "@types/d3-time-format": "^4.0.3",
    "@types/jest": "^29.5.13",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "@types/socket.io": "^3.0.2",
    "concurrently": "^9.2.1",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.2.11",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
