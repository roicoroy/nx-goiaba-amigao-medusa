{
  "name": "@lambdacurry/medusa-webhooks",
  "version": "1.1.4",
  "description": "A Medusa plugin that enables webhook management and integration, allowing you to configure and manage outgoing webhooks for your e-commerce events.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "files": [
    ".medusa/server"
  ],
  "types": "./.medusa/server/src/types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "keywords": [
    "medusa",
    "plugin",
    "webhooks",
    "medusa-v2",
    "medusa-plugin-integration",
    "medusa-plugin-other",
    "medusa-plugin-webhooks",
    "medusa-plugin",
    "event-driven",
    "integration",
    "notifications"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "prepublishOnly": "sh -c 'if [ -n \"$SKIP_PREPUBLISH\" ]; then exit 0; else medusa plugin:build; fi'",
    "deploy": "npm run build && SKIP_PREPUBLISH=1 yalc publish",
    "publish:yalc": "npx yalc publish",
    "generate": "medusa plugin:db:generate",
    "resolve:aliases": "tsc --showConfig -p tsconfig.json > tsconfig.resolved.json && tsc-alias -p tsconfig.resolved.json && rimraf tsconfig.resolved.json"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "2.7.0",
    "@medusajs/cli": "2.7.0",
    "@medusajs/framework": "2.7.0",
    "@medusajs/icons": "2.7.0",
    "@medusajs/medusa": "2.7.0",
    "@medusajs/test-utils": "2.7.0",
    "@medusajs/ui": "4.0.3",
    "@mikro-orm/cli": "6.4.3",
    "@mikro-orm/core": "6.4.3",
    "@mikro-orm/knex": "6.4.3",
    "@mikro-orm/migrations": "6.4.3",
    "@mikro-orm/postgresql": "6.4.3",
    "awilix": "^8.0.1",
    "pg": "^8.13.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@medusajs/js-sdk": "^2.7.0",
    "@tanstack/react-table": "^8.21.2",
    "clsx": "^2.1.1",
    "react-hook-form": "^7.54.2",
    "react-json-view-lite": "^2.3.0"
  },
  "yalcSig": "ab7938b9e0651ca93e3890e46d1dcd16"
}
