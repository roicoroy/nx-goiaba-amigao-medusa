{
  "name": "wishlist-plugin",
  "version": "0.5.1",
  "description": "Plugin for wishlist functionality in Medusa.",
  "author": "Shahed Nasser <shahednasser@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/medusajs/examples.git",
    "directory": "wishlist-plugin"
  },
  "license": "MIT",
  "files": [
    ".medusa/server"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "keywords": [
    "medusa-v2",
    "plugin",
    "medusa-plugin-other"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "prepublishOnly": "sh -c 'if [ -n \"$SKIP_PREPUBLISH\" ]; then exit 0; else medusa plugin:build; fi'",
    "deploy": "npm run build && SKIP_PREPUBLISH=1 yalc publish",
    "publish:yalc": "npx yalc publish"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "^2.12.3",
    "@medusajs/cli": "^2.12.3",
    "@medusajs/framework": "^2.12.3",
    "@medusajs/icons": "^2.12.3",
    "@medusajs/js-sdk": "^2.12.3",
    "@medusajs/medusa": "^2.12.3",
    "@medusajs/test-utils": "^2.12.3",
    "@medusajs/ui": "4.0.12"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.2"
  },
  "yalcSig": "0843c38de67c66a8175b6a1c30a20239"
}
