{
  "name": "@rsc-labs/medusa-products-bought-together-v2",
  "version": "0.0.3",
  "description": "Monitor and get products which are bought together",
  "author": "RSC Labs (https://rsoftcon.com)",
  "license": "MIT",
  "files": [
    ".medusa/server"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/RSC-Labs/medusa-products-bought-together"
  },
  "exports": {
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./*": "./.medusa/server/src/*.js"
  },
  "keywords": [
    "medusa-plugin",
    "medusa-v2",
    "store",
    "products",
    "products bought together",
    "recommendations"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "prepublishOnly": "sh -c 'if [ -n \"$SKIP_PREPUBLISH\" ]; then exit 0; else medusa plugin:build; fi'",
    "deploy": "npm run build && SKIP_PREPUBLISH=1 yalc publish",
    "publish:yalc": "npx yalc publish"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "^2.12.3",
    "@medusajs/cli": "^2.12.3",
    "@medusajs/framework": "^2.12.3",
    "@medusajs/icons": "^2.12.0",
    "@medusajs/medusa": "^2.12.3",
    "@medusajs/test-utils": "^2.12.3",
    "@medusajs/ui": "^4.0.12",
    "@mikro-orm/cli": "6.4.3",
    "@mikro-orm/core": "6.4.3",
    "@mikro-orm/knex": "6.4.3",
    "@mikro-orm/migrations": "6.4.3",
    "@mikro-orm/postgresql": "6.4.3",
    "awilix": "^8.0.1",
    "pg": "^8.13.0"
  },
  "engines": {
    "node": ">=20"
  },
  "yalcSig": "33a19cf274416287007ebc8833de47d8"
}
