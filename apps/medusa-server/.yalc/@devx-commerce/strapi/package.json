{
  "name": "@devx-commerce/strapi",
  "version": "0.0.12",
  "description": "Medusa plugin for Strapi as CMS",
  "author": "devx commerce (https://devxcommerce.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/devx-commerce/medusa-strapi-plugin",
    "directory": "medusa-strapi-plugin"
  },
  "files": [
    ".medusa/server"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "keywords": [
    "medusa-v2",
    "medusa",
    "plugin",
    "medusa-plugin",
    "medusa-plugin-cms",
    "medusa-plugin-integration",
    "medusa-plugin-strapi",
    "strapi"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "prepublishOnly": "sh -c 'if [ -n \"$SKIP_PREPUBLISH\" ]; then exit 0; else medusa plugin:build; fi'",
    "deploy": "npm run build && SKIP_PREPUBLISH=1 yalc publish",
    "publish:yalc": "npx yalc publish",
    "release": "yarn standard-version"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "^2.12.3",
    "@medusajs/cli": "^2.12.3",
    "@medusajs/framework": "^2.12.3",
    "@medusajs/icons": "^2.12.3",
    "@medusajs/medusa": "^2.12.3",
    "@medusajs/test-utils": "^2.12.3",
    "@medusajs/ui": "^4.0.12",
    "@mikro-orm/cli": "6.4.3",
    "@mikro-orm/core": "6.4.3",
    "@mikro-orm/knex": "6.4.3",
    "@mikro-orm/migrations": "6.4.3",
    "@mikro-orm/postgresql": "6.4.3",
    "pg": "^8.13.0",
    "qs": "^6.14.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "yalcSig": "5c3d1906824e0ac9d14e295c306d5003"
}
